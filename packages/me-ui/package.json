    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/sync-registry.mjs --check"
  },
  "keywords": [
    "ui",
    "components",
    "react",
    "tailwind",
    "base-ui",
    "shadcn",
    "cli"
  ],
  "license": "MIT"
}
