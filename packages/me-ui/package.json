{
  "name": "@mahiraltinkaya/me-ui",
  "version": "0.2.0",
  "description": "Copy React + Tailwind form components into any project — they become your files, not a dependency.",
  "type": "module",
  "bin": {
    "me-ui": "bin/me-ui.js"
  },
  "files": [
    "bin",
    "src",
    "registry",
    "registry.json"
  ],
  "engines": {
    "node": ">=20.11"
  },
